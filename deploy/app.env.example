# Save a private copy as /etc/yichen-drive/app.env, directory 700 and file 600.
# The final domain is required. Never use a localhost origin for public deployment.
YICHEN_PUBLIC_ORIGIN=https://YOUR_DOMAIN
YICHEN_DATA_DIR=/var/lib/yichen-drive
YICHEN_SMTP_HOST=smtp.qq.com
YICHEN_SMTP_PORT=465
YICHEN_SMTP_USER=2712723487@qq.com
YICHEN_NOTIFY_EMAIL=2712723487@qq.com
YICHEN_SMTP_PASSWORD=
# Optional server-only AMap settings, configure with a real authorised key if needed.
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
